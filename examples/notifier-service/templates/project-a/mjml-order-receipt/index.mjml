<mjml>
  <mj-head>
    <mj-title>Order {{orderId}}: {{appName}}</mj-title>
    <mj-preview>Order {{orderId}} confirmed for {{customerName}}.</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text color="#18181b" font-size="16px" line-height="1.6" />
      <mj-button background-color="#18181b" color="#ffffff" border-radius="6px" font-weight="600" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f5">
    <mj-section background-color="#18181b" padding="24px 32px">
      <mj-column>
        <mj-text color="#ffffff" font-size="18px" font-weight="600" padding="0">
          {{appName}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="32px">
      <mj-column>
        <mj-text font-size="24px" font-weight="600" padding="0 0 8px">
          Order confirmed
        </mj-text>
        <mj-text color="#3f3f46" padding="0 0 16px">
          Hi {{customerName}}, thanks for your order <strong>{{orderId}}</strong>.
        </mj-text>

        {{#if isGift}}
        <mj-text color="#3f3f46" font-size="14px" padding="12px 14px" background-color="#f4f4f5">
          This order is marked as a gift, so we will not include pricing on the packing slip.
        </mj-text>
        {{/if}}

        {{#each lineItems}}
        <mj-text padding="8px 0" font-size="15px">
          {{quantity}}× {{name}}: {{price}}
        </mj-text>
        {{/each}}

        <mj-text font-size="16px" font-weight="600" padding="16px 0 0">
          Total: {{total}}
        </mj-text>

        {{#if shippingAddress}}
        <mj-text color="#71717a" font-size="13px" padding="20px 0 4px">
          Ships to
        </mj-text>
        <mj-text color="#3f3f46" font-size="15px" padding="0 0 16px">
          {{shippingAddress}}
        </mj-text>
        {{/if}}

        {{#if trackingUrl}}
        <mj-button href="{{trackingUrl}}" padding="8px 0 0" align="left">
          Track shipment
        </mj-button>
        {{/if}}
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
