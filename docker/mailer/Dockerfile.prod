FROM node:24-alpine AS base


FROM base AS prune

RUN apk add --no-cache gcompat

WORKDIR /app
COPY . .
RUN npm i --global turbo@2.7.0
RUN turbo prune mailer --docker


FROM base AS builder

WORKDIR /app

COPY --from=prune /app/out/full/ .
COPY --from=prune /app/out/json/package-lock.json .

RUN npm install

# Bundle server + compile-templates CLI
RUN npm run build -- --filter=mailer


# Install runtime peers on Debian (matches Distroless glibc; avoid Alpine/musl native mismatches)
FROM node:24-bookworm-slim AS runtime-deps

WORKDIR /app

COPY docker/mailer/package.runtime.json ./package.json
COPY --from=builder /app/apps/mailer/dist ./dist

RUN npm install --omit=dev \
  && npm cache clean --force \
  && rm -rf /root/.npm /tmp/* \
  && mkdir -p /app/templates \
  && chown -R 65532:65532 /app


# Distroless: entrypoint is /nodejs/bin/node (no shell/npm)
FROM gcr.io/distroless/nodejs24-debian12:nonroot AS runner

WORKDIR /app

ENV NODE_ENV=production
# Default; consumer images bake compiled templates here
ENV TEMPLATES_DIR=/app/templates

COPY --from=runtime-deps --chown=65532:65532 /app /app

CMD ["dist/index.cjs"]
