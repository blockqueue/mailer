FROM node:24-alpine AS base


# Prune stage
FROM base AS prune

RUN apk add --no-cache gcompat

WORKDIR /app
COPY . .
RUN npm i --global turbo@2.7.0
RUN turbo prune mailer --docker


# Build stage
FROM base AS builder

WORKDIR /app

# Copy pruned package files
COPY --from=prune /app/out/full/ .
COPY --from=prune /app/out/json/package-lock.json .

RUN npm install

# Bundle the application (server + compile-templates CLI)
RUN npm run build -- --filter=mailer


# Runtime deps stage (Alpine has npm; final image will not)
FROM base AS runtime-deps

WORKDIR /app

COPY docker/mailer/package.runtime.json ./package.json
COPY --from=builder /app/apps/mailer/dist ./dist

# Install only render peers.
RUN npm install --omit=dev \
  && npm cache clean --force \
  && rm -rf /root/.npm /tmp/* \
  && mkdir -p /templates \
  && ln -sfn /app/node_modules /templates/node_modules \
  && chown -R 65532:65532 /app /templates


# Final stage — Google Distroless.
# Entrypoint is already /nodejs/bin/node; no shell, npm, or yarn.
FROM gcr.io/distroless/nodejs24-debian12:nonroot AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY --from=runtime-deps --chown=65532:65532 /app /app
COPY --from=runtime-deps --chown=65532:65532 /templates /templates

CMD ["dist/index.cjs"]
