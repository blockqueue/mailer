FROM node:24-alpine AS base

# Turbo (and some native Node addons) need glibc compatibility on Alpine.
# See https://turborepo.dev/docs/guides/tools/docker
RUN apk update && apk add --no-cache libc6-compat


FROM base AS prune

WORKDIR /app
COPY . .
RUN npm i --global turbo@2.10.9
RUN turbo prune notifier --docker


FROM base AS builder

WORKDIR /app

COPY --from=prune /app/out/full/ .
COPY --from=prune /app/out/json/package-lock.json .

RUN npm install
RUN npm run build -- --filter=notifier


FROM node:24-bookworm-slim AS runtime-deps

WORKDIR /app

COPY docker/notifier/package.runtime.json ./package.json
COPY docker/notifier/stubs ./stubs
COPY --from=builder /app/apps/notifier/dist ./dist

# omit optional (e.g. handlebars→uglify-js); overrides stub prettier/js-beautify/htmlnano/cssnano
# so we do not ship unused pretty/beautify/minify trees (~40MB). Keep ./stubs — npm links overrides there.
RUN npm install --omit=dev --omit=optional \
  && npm cache clean --force \
  && rm -rf /root/.npm /tmp/* \
  && mkdir -p /app/templates \
  && chown -R 65532:65532 /app


FROM gcr.io/distroless/nodejs24-debian12:nonroot AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV TEMPLATES_DIR=/app/templates

COPY --from=runtime-deps --chown=65532:65532 /app /app

CMD ["dist/index.cjs"]
