{
  "name": "notifier",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "npm run build:server && npm run build:compile-templates",
    "build:server": "NODE_ENV=production esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs --minify --packages=bundle --external:react --external:react-dom --external:react/jsx-runtime --external:react/jsx-dev-runtime --external:@react-email/render --external:mjml",
    "build:compile-templates": "NODE_ENV=production esbuild src/cli/compile-templates.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/compile-templates.mjs --minify --external:esbuild --external:mjml",
    "compile-templates": "tsx src/cli/compile-templates.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "lint": "eslint . --ext .ts,.tsx",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.700.0",
    "@hono/node-server": "^1.19.6",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "aws-sdk-v3-proxy": "^2.2.0",
    "axios": "^1.13.2",
    "dotenv": "^16.0.3",
    "hono": "^4.11.2",
    "js-yaml": "^4.1.1",
    "mjml": "^4.18.0",
    "nodemailer": "^7.0.12",
    "pino": "^10.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@hono/eslint-config": "^2.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.3",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "tsx": "^4.7.1",
    "typescript": "6.0.3",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
